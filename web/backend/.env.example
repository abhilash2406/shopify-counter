PORT=3000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=countdown_timer

# error | warn | info | http | verbose | debug | silly
# Defaults to debug in development, info in production.
LOG_LEVEL=debug

# Basic-auth credentials for the Swagger UI at /api-docs.
# Leave SWAGGER_PASSWORD empty to disable the docs route entirely — it is
# never served unprotected.
SWAGGER_USER=admin
SWAGGER_PASSWORD=admin@123
